# Application Configuration
APP_NAME=AI-Asset-Intelligence-Backend
APP_ENV=development
APP_VERSION=0.1.0

# Server Configuration
HOST=127.0.0.1
PORT=8000
RELOAD=true

# API Configuration
API_PREFIX=/api/v1
API_TITLE=AI Asset Intelligence

# Database Configuration
DATABASE_URL=postgresql+asyncpg://asset_admin:CHANGE_ME@localhost:5432/asset_intelligence

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Logging Configuration
LOG_LEVEL=INFO

# Request/Response Configuration
CORRELATION_ID_HEADER=X-Correlation-ID
