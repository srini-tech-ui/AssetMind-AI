# Vite Environment Variables
# These are used in the frontend application

# Base URL for the API backend
VITE_API_BASE_URL=http://localhost:3000/api

# Set to "true" to enable mock mode (for development/testing)
VITE_USE_MOCKS=false

# OIDC Configuration (for production authentication)
# These are placeholders - replace with actual values in production
# VITE_OIDC_AUTHORITY=https://your-keycloak-domain/auth/realms/your-realm
# VITE_OIDC_CLIENT_ID=your-client-id
# VITE_OIDC_REDIRECT_URI=${window.location.origin}/callback
# VITE_OIDC_SILENT_REDIRECT_URI=${window.location.origin}/silent-renew.html
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=${window.location.origin}
# VITE_OIDC_RESPONSE_TYPE=code
# VITE_OIDC_SCOPE=openid profile email offline_access
# VITE_OIDC_FILTER_PROFILE_CLAIMS=true
# VITE_OIDC_LOAD_USER_INFO=true
# VITE_OIDC_AUTO_USERINFO=true